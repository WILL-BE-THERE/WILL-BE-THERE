# Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# API Base URL - Update this to match your backend server
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Configuration (optional)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Firebase Configuration (optional, if using Firebase)
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id

# Notes:
# 1. Never commit .env.local to version control; only commit .env.example as a template
# 2. Update VITE_API_BASE_URL to point to your backend server (localhost for dev, domain for prod)
# 3. For Google OAuth and Firebase, obtain credentials from their respective consoles
# 4. Vite exposes variables prefixed with VITE_ to the browser; others are server-only
